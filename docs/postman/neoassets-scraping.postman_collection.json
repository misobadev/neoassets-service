        {
          "name": "Popular",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('games is an array', () => pm.expect(j.games).to.be.an('array'));",
                  "if (j.games.length > 0) {",
                  "  pm.test('rows have scrapes and are ordered desc', () => {",
                  "    pm.expect(j.games[0]).to.have.property('scrapes');",
                  "    for (let i = 1; i < j.games.length; i++) {",
                  "      pm.expect(j.games[i - 1].scrapes).to.be.at.least(j.games[i].scrapes);",
                  "    }",
                  "  });",
                  "}",
                  "pm.test('quota headers present', () => pm.expect(pm.response.headers.has('X-Quota-Remaining')).to.be.true);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/scrape/popular?limit=10&softname={{softname}}",
            "description": "Most scraped games (free). Optional system_id filters the ranking."
          },
          "response": []
        },
        {
          "name": "Account",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('subject is user or guest', () => pm.expect(['user', 'guest']).to.include(j.subject));",
                  "pm.test('client is identified', () => {",
                  "  pm.expect(j.client).to.have.property('id');",
                  "  pm.expect(j.client).to.have.property('name');",
                  "});",
                  "pm.test('quota is complete', () => {",
                  "  pm.expect(j.quota).to.have.property('daily_limit');",
                  "  pm.expect(j.quota).to.have.property('used');",
                  "  pm.expect(j.quota).to.have.property('remaining');",
                  "  pm.expect(j.quota).to.have.property('resets_at');",
                  "});",
                  "if (pm.variables.get('userApiKey')) {",
                  "  pm.test('registered user has a username', () => {",
                  "    pm.expect(j.subject).to.eql('user');",
                  "    pm.expect(j.user).to.have.property('username');",
