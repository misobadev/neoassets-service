                  "pm.test('returns a game', () => pm.expect(j.game).to.not.eql(null));",
                  "pm.test('quota remaining is numeric', () => pm.expect(Number(pm.response.headers.get('X-Quota-Remaining'))).to.be.a('number'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/scrape/games?system_id={{systemId}}&{{romHashParam}}={{romHash}}&name={{searchName}}&softname={{softname}}",
            "description": "Hash + name together: the hash wins and the name is the fallback. Consumes one quota unit."
