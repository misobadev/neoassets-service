          ]
        },
        {
          "name": "Games - by name",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Fallbacks so the selectors are never empty.",
                  "if (!pm.variables.get('systemId')) { pm.variables.set('systemId', 'snes'); }",
                  "if (!pm.variables.get('searchName')) { pm.variables.set('searchName', 'mario'); }",
                  "console.log('Scrape by name: ' + pm.variables.get('searchName') + ' in ' + pm.variables.get('systemId'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('system_id is echoed', () => pm.expect(j.system_id).to.eql(pm.variables.get('systemId')));",
                  "pm.test('matched_by is name', () => pm.expect(j.matched_by).to.eql('name'));",
                  "if (j.game) {",
                  "  const game = j.game;",
                  "  pm.test('game has id, name and roms', () => {",
                  "    pm.expect(game).to.have.property('id');",
                  "    pm.expect(game).to.have.property('name');",
                  "    pm.expect(game.roms).to.be.an('array');",
                  "  });",
                  "  pm.test('game has media and a scrapes counter', () => {",
                  "    pm.expect(game.media).to.be.an('array');",
                  "    pm.expect(game).to.have.property('scrapes');",
                  "  });",
                  "  const roms = game.roms || [];",
                  "  const withSha1 = roms.find(r => r.sha1 && r.sha1.length);",
                  "  const withCrc = roms.find(r => r.crc && r.crc.length);",
                  "  if (withSha1) {",
                  "    pm.collectionVariables.set('romHash', withSha1.sha1);",
                  "    pm.collectionVariables.set('romHashParam', 'sha1');",
                  "  } else if (withCrc) {",
                  "    pm.collectionVariables.set('romHash', withCrc.crc);",
                  "    pm.collectionVariables.set('romHashParam', 'crc');",
                  "  }",
                  "  pm.test('stored romHash for the by-hash requests', () => pm.expect(pm.collectionVariables.get('romHash')).to.not.be.empty);",
                  "} else {",
                  "  console.log('No game matched \"' + pm.variables.get('searchName') + '\" in ' + pm.variables.get('systemId') + '. Adjust searchName/systemId.');",
                  "}",
                  "pm.test('quota remaining is numeric', () => pm.expect(Number(pm.response.headers.get('X-Quota-Remaining'))).to.be.a('number'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/scrape/games?system_id={{systemId}}&name={{searchName}}&type={{gameType}}&roms=true&softname={{softname}}",
            "description": "Name search scoped to system_id (name is cleaned server-side). Optional `type` filter: base, hack or homebrew. `roms=true` includes the ROM list so a hash can be captured. Returns one game and consumes one quota unit; stores romHash for the by-hash requests."
          },
          "response": []
        },
        {
          "name": "Games - by system (arcade)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('returns Street Fighter Alpha 3', () => {",
                  "  pm.expect(j.game).to.not.be.null;",
                  "  pm.expect(j.game.system_id).to.eql('arc');",
                  "});",
                  "pm.test('matched by name', () => pm.expect(j.matched_by).to.eql('name'));",
                  "pm.test('resolves Street Fighter Alpha 3 on cps2', () => {",
                  "  pm.expect(j.game).to.not.be.null;",
                  "  pm.expect(j.game.name).to.eql('Street Fighter Alpha 3');",
                  "  pm.expect(j.game.system_id).to.eql('cps2');",
                  "  pm.expect(j.game.rom_name).to.eql('sfa3.zip');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/scrape/games?system_id=arc&name=sfa3.zip&softname={{softname}}",
            "description": "Look up a game by its ROM set name in the virtual `arc` system. `arc` is a virtual system: it owns no games and aggregates the whole `arcade` family, so `sfa3.zip` resolves the CPS2 entry (Street Fighter Alpha 3) without duplicating it. Same as family=arcade; for MAME/FBNeo only use group=mame-fbneo."
          },
          "response": []
        },
        {
          "name": "Games - by hash",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "const hash = pm.collectionVariables.get('romHash');",
                  "if (hash) {",
                  "  pm.test('matched_by is hash', () => pm.expect(j.matched_by).to.eql('hash'));",
                  "  pm.test('returns a game with ROM hashes', () => {",
                  "    pm.expect(j.game).to.not.eql(null);",
                  "    pm.expect(j.game.roms.length).to.be.above(0);",
                  "  });",
                  "} else {",
                  "  pm.test('romHash is set (run Games - by name first)', () => pm.expect(hash).to.not.be.empty);",
                  "}",
                  "pm.test('quota remaining is numeric', () => pm.expect(Number(pm.response.headers.get('X-Quota-Remaining'))).to.be.a('number'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/scrape/games?system_id={{systemId}}&{{romHashParam}}={{romHash}}&roms=true&softname={{softname}}",
            "description": "ROM identification by hash (crc/md5/sha1/sha256), scoped to system_id. `roms=true` includes the ROM list. The hash is captured from `Games - by name`."
          },
          "response": []
        },
