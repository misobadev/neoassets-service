                  "} else {",
                  "  pm.test('guest has no user and the guest daily limit', () => {",
                  "    pm.expect(j.subject).to.eql('guest');",
                  "    pm.expect(j.user).to.eql(null);",
                  "    pm.expect(j.quota.daily_limit).to.eql(2000);",
                  "  });",
                  "}",
                  "pm.test('quota headers present', () => {",
                  "  pm.expect(pm.response.headers.has('X-Quota-Limit')).to.be.true;",
                  "  pm.expect(pm.response.headers.has('X-Quota-Remaining')).to.be.true;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/scrape/account",
            "description": "Current subject and quota. Free. Asserts the guest daily limit (1000) when no user API key is set."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Rate limit",
      "item": [
        {
          "name": "Rate Limit - Guest",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Guest mode: never send a user credential.",
                  "pm.request.headers.remove('Authorization');",
                  "if (pm.collectionVariables.get('guestRLRunning') !== 'true') {",
                  "  pm.collectionVariables.set('guestRLCount', '0');",
                  "  pm.collectionVariables.set('guestRLHit', 'false');",
                  "  pm.collectionVariables.set('guestRLRunning', 'true');",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const code = pm.response.code;",
                  "const count = Number(pm.collectionVariables.get('guestRLCount')) + 1;",
                  "pm.collectionVariables.set('guestRLCount', String(count));",
                  "if (code === 429) {",
                  "  pm.collectionVariables.set('guestRLHit', 'true');",
                  "}",
                  "pm.test('response is 200 or 429 (request #' + count + ')', () => pm.expect([200, 429]).to.include(code));",
                  "if (pm.collectionVariables.get('guestRLHit') === 'true') {",
                  "  pm.test('guest rate limit triggered (429) after ' + count + ' requests', () => pm.expect(true).to.be.true);",
                  "  pm.collectionVariables.set('guestRLRunning', 'false');",
                  "  pm.execution.setNextRequest(null);",
                  "} else if (count < 40) {",
                  "  pm.execution.setNextRequest('Rate Limit - Guest');",
                  "} else {",
                  "  pm.collectionVariables.set('guestRLRunning', 'false');",
                  "  pm.test('guest rate limit triggered within 40 requests', () => pm.expect.fail('No 429 after ' + count + ' requests. Check SCRAPE_GUEST_RPM.'));",
                  "  pm.execution.setNextRequest(null);",
                  "}",
                  "if (code === 429) {",
                  "  pm.test('429 body has an error message', () => pm.expect(pm.response.json()).to.have.property('error'));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/scrape/account",
            "description": "Guest rate limit test. Loops itself until a 429 appears (default guest limit is 10 req/min). MUST be run with the Collection Runner. Leave `userApiKey` empty."
          },
          "response": []
        },
        {
          "name": "Rate Limit - User",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const key = pm.variables.get('userApiKey');",
                  "if (key) {",
                  "  pm.request.headers.upsert({ key: 'Authorization', value: 'Bearer ' + key });",
                  "}",
                  "if (pm.collectionVariables.get('userRLRunning') !== 'true') {",
                  "  pm.collectionVariables.set('userRLCount', '0');",
                  "  pm.collectionVariables.set('userRLHit', 'false');",
                  "  pm.collectionVariables.set('userRLRunning', 'true');",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const key = pm.variables.get('userApiKey');",
                  "if (!key) {",
                  "  pm.test('userApiKey is set to test the user rate limit', () => pm.expect.fail('Set the userApiKey environment variable (Profile > API keys).'));",
                  "  pm.collectionVariables.set('userRLRunning', 'false');",
                  "  pm.execution.setNextRequest(null);",
                  "} else {",
                  "  const code = pm.response.code;",
                  "  const count = Number(pm.collectionVariables.get('userRLCount')) + 1;",
                  "  pm.collectionVariables.set('userRLCount', String(count));",
                  "  if (code === 429) {",
                  "    pm.collectionVariables.set('userRLHit', 'true');",
                  "  }",
                  "  pm.test('response is 200 or 429 (request #' + count + ')', () => pm.expect([200, 429]).to.include(code));",
                  "  if (pm.collectionVariables.get('userRLHit') === 'true') {",
                  "    pm.test('user rate limit triggered (429) after ' + count + ' requests', () => pm.expect(true).to.be.true);",
                  "    pm.collectionVariables.set('userRLRunning', 'false');",
                  "    pm.execution.setNextRequest(null);",
                  "  } else if (count < 90) {",
                  "    pm.execution.setNextRequest('Rate Limit - User');",
                  "  } else {",
                  "    pm.collectionVariables.set('userRLRunning', 'false');",
                  "    pm.test('user rate limit triggered within 90 requests', () => pm.expect.fail('No 429 after ' + count + ' requests. Check SCRAPE_USER_RPM.'));",
                  "    pm.execution.setNextRequest(null);",
                  "  }",
                  "  if (code === 429) {",
                  "    pm.test('429 body has an error message', () => pm.expect(pm.response.json()).to.have.property('error'));",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/scrape/account",
            "description": "Registered-user rate limit test. Loops itself until a 429 appears (default user limit is 60 req/min). MUST be run with the Collection Runner and a valid `userApiKey`."
          },
          "response": []
        }
      ]
    },
    {
      "name": "System Art Packs",
      "item": [
        {
          "name": "Packs - List",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/packs?sort=downloads&limit=10&offset=0",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "packs"
              ],
              "query": [
                {
                  "key": "sort",
                  "value": "downloads",
                  "description": "downloads (default), name or created"
                },
                {
                  "key": "limit",
                  "value": "10"
                },
                {
                  "key": "offset",
                  "value": "0"
                }
              ]
            },
            "description": "Public list of approved System Art Packs, sorted by downloads and paginated. Returns { themes, total }."
          },
          "response": []
        },
        {
          "name": "Pack - Detail",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/packs/{{packId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "packs",
                "{{packId}}"
              ]
            },
            "description": "Full public payload of one approved pack: metadata, every published file with public URLs, pending contributions and contributor names. Pure read: does NOT bump the download counter."
          },
          "response": []
        },
        {
          "name": "Contribute - create submission",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{packName}}\",\n  \"author\": \"{{packAuthor}}\",\n  \"description\": \"An updated description contributed to this pack.\",\n  \"contribution\": true,\n  \"pack_id\": \"{{packId}}\",\n  \"files\": []\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/submissions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "submissions"
              ]
            },
            "description": "Create a contribution (pending review) to an existing approved pack. Set packId, packName, packAuthor and userToken (a user JWT from POST /login) first. Files (object_key of staged uploads) can be added to the `files` array."
          },
          "response": []
        },
        {
          "name": "Pack - Download",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/packs/{{packId}}/download",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "packs",
                "{{packId}}",
                "download"
              ]
            },
            "description": "Same payload as Pack - Detail, but bumps the pack download counter. This is the install/scrape action that front-ends call when a pack is actually installed.\n\nRate limited per (client IP, pack): a client may download the same pack only a few times per minute (429 when exceeded), so download counters cannot be inflated by flooding."
          },
          "response": []
        },
        {
          "name": "Scrape - Packs List",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/scrape/packs?limit=10&offset=0",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "scrape",
                "packs"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "10"
                },
                {
                  "key": "offset",
                  "value": "0"
                }
              ]
            },
            "description": "Public scraping API: approved System Art Packs with a ready-to-use preview URL and the first four background images each. Requires developer credentials (X-Client-Id / X-Client-Secret). Free (does not consume quota). Returns { packs, total }."
          },
          "response": []
        },
        {
          "name": "Scrape - Pack Download",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/scrape/packs/{{packId}}/download",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "scrape",
                "packs",
                "{{packId}}",
                "download"
              ]
            },
            "description": "Public scraping API: one System Art Pack with every published file (all its images) as public URLs. Requires developer credentials. Each call bumps the pack download counter and consumes one unit of the daily quota."
          },
          "response": []
        }
      ]
    }
  ]
