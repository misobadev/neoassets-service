            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/scrape/games?group={{group}}&name={{searchName}}&softname={{softname}}",
            "description": "Look up a single game across every system of a group (e.g. mame-fbneo). Same selectors as by system_id."
