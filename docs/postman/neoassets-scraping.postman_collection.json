  "item": [
    {
      "name": "Scraping API",
      "item": [
        {
          "name": "Systems",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('systems is an array', () => pm.expect(j.systems).to.be.an('array'));",
                  "pm.test('systems is not empty', () => pm.expect(j.systems.length).to.be.above(0));",
                  "pm.test('system has id and name', () => {",
                  "  const s = j.systems[0];",
                  "  pm.expect(s).to.have.property('id');",
                  "  pm.expect(s).to.have.property('name');",
                  "});",
                  "pm.test('quota headers present', () => {",
                  "  pm.expect(pm.response.headers.has('X-Quota-Limit')).to.be.true;",
                  "  pm.expect(pm.response.headers.has('X-Quota-Remaining')).to.be.true;",
                  "  pm.expect(pm.response.headers.has('X-Quota-Reset')).to.be.true;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/scrape/systems",
            "description": "Metadata system catalog. Free (does not consume quota). Pick a `systemId` from here."
          },
          "response": []
        },
