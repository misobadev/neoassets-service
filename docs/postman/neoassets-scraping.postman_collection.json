  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Common scrape credentials for every request.",
          "pm.request.headers.upsert({ key: 'X-Client-Id', value: pm.variables.get('clientId') });",
          "pm.request.headers.upsert({ key: 'X-Client-Secret', value: pm.variables.get('clientSecret') });",
          "const userKey = pm.variables.get('userApiKey');",
          "if (userKey) {",
          "  pm.request.headers.upsert({ key: 'Authorization', value: 'Bearer ' + userKey });",
          "} else {",
          "  pm.request.headers.remove('Authorization');",
          "}"
        ]
      }
    }
