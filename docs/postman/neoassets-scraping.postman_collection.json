            "description": "System groups (emulator sub-sets such as mame-fbneo, flycast) with their system and game counts. Free."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
