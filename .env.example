# NeoAssets Service
PORT=8090

# PostgreSQL (managed externally; no bundled database in the compose).
# Local dev: point to your local Postgres (e.g. 127.0.0.1:5433). Dokploy: the
# managed database hostname on the dokploy-network (e.g. neoassets-database-xxxx).
DATABASE_URL=postgres://neoassets_user:change-me-db-password@127.0.0.1:5433/neoassets?sslmode=disable

# JWT for the admin panel
JWT_SECRET=change-me-to-a-long-random-string

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=https://cdn.neoassets.dev

# Optional Cloudflare API token (R2 reporting read) used to report storage
# usage on the dashboard. Not required for media uploads.
CF_API_TOKEN=

# Initial admin (seeded into the DB on startup)
ADMIN_SEED_EMAIL=admin@mail.com
ADMIN_SEED_PASSWORD=change-me
# Protected admin account (cannot be demoted/deleted from the admin panel).
PROTECTED_ADMIN_EMAIL=admin@mail.com

# Public scraping API. 0 uses the built-in defaults:
# guest threads = 2, admin threads = 16. Donors get an additive thread bonus
# (supporter +2, monthly +4) on top of their level base threads, capped at 16,
# plus an XP bonus (supporter +25%, monthly +50%). Daily = threads * SCRAPE_DAILY_GAMES_PER_THREAD.
SCRAPE_GUEST_THREADS=2
SCRAPE_ADMIN_THREADS=16
SCRAPE_SUPPORTER_BONUS_THREADS=2
SCRAPE_MONTHLY_SUPPORTER_BONUS_THREADS=4
XP_SUPPORTER_BONUS_PCT=25
XP_MONTHLY_SUPPORTER_BONUS_PCT=50
SCRAPE_DAILY_GAMES_PER_THREAD=1000
SCRAPE_GUEST_RPM=60
SCRAPE_USER_RPM=240

# Donations (Ko-fi / Patreon -> donor status). KOFI_VERIFICATION_TOKEN is the
# token from the Ko-fi webhooks page; leave empty to disable the webhook.
# PATREON_WEBHOOK_SECRET is the secret of the Patreon member webhook; leave
# empty to disable it. DONOR_SUBSCRIPTION_GRACE_DAYS is the inactivity window
# after which a monthly supporter with no fresh subscription payment is
# downgraded (default 40).
KOFI_VERIFICATION_TOKEN=
PATREON_WEBHOOK_SECRET=
DONOR_SUBSCRIPTION_GRACE_DAYS=40

# XP economy (XP awarded per approved contribution).
POINTS_TEXT_METADATA=10
POINTS_IMAGE_METADATA=50
POINTS_VIDEO_METADATA=100
POINTS_SAP_IMAGE=20
POINTS_NEW_GAME=100

# Scraping debug overrides (forcerequestok/forcethreads/forceratelimit) via
# X-Debug-Password. Keep off in production.
ENABLE_DEBUG_MODE=false

# Allowed browser origins for CORS (comma separated).
CORS_ORIGINS=http://localhost:5173,http://localhost:8091

# Set to "true" to allow login without verifying email (local dev only)
SKIP_EMAIL_VERIFICATION=false

# Account emails (SMTP) + links back to the web frontend
SMTP_HOST=smtp.mail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=NeoAssets Team
FRONTEND_URL=http://localhost:8091
# Public logo used in email headers. Falls back to the code default when empty.
EMAIL_LOGO_URL=

# Translate worker (Cloudflare Worker, Workers AI m2m100). When set, approving a
# metadata submission that carries an English description auto-generates the
# translations into game_translations / system_translations.
TRANSLATE_WORKER_URL=
TRANSLATE_WORKER_TOKEN=
