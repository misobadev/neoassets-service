# NeoAssets Service
PORT=8090

# PostgreSQL (managed externally; no bundled database in the compose).
# Local dev: point to your local Postgres (e.g. 127.0.0.1:5433). Dokploy: the
# managed database hostname on the dokploy-network (e.g. neoassets-database-xxxx).
DATABASE_URL=postgres://neoassets_user:change-me-db-password@127.0.0.1:5433/neoassets?sslmode=disable
# Connection pool size and per-statement timeout (seconds) for the service's
# queries; 0 disables either. Migrations run without the timeout. The timeout
# is sent as a connection parameter: behind a pooler that rejects unknown
# startup parameters (e.g. PgBouncer), set it on the role instead and use 0.
#DB_MAX_OPEN_CONNS=20
#DB_STATEMENT_TIMEOUT_SECONDS=30
# Seconds the catalog aggregates (systems, families, groups, languages, the
# public dashboard) are cached in memory; approvals clear them. 0 disables.
#CATALOG_CACHE_SECONDS=60

# JWT for the admin panel
# Required: a random value of at least 32 characters, e.g. `openssl rand -base64 48`.
JWT_SECRET=

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=https://cdn.neoassets.dev

# Optional Cloudflare API token (R2 reporting read) used to report storage
# usage on the dashboard. Not required for media uploads.
CF_API_TOKEN=

# Initial admin (seeded into the DB on startup)
ADMIN_SEED_EMAIL=admin@mail.com
# Required with ADMIN_SEED_EMAIL: used only to create the first admin; choose a strong password.
ADMIN_SEED_PASSWORD=
# Protected admin account (cannot be demoted/deleted from the admin panel).
PROTECTED_ADMIN_EMAIL=owner@example.com

# Public scraping API. 0 uses the built-in defaults:
# guest threads = 1, admin threads = 20. Registered users get their level
# rank's threads (Novice 2, +2 per rank up to Legend 20). Donors get an
# additive thread bonus (supporter +2, monthly +4) on top, capped at 20,
# plus an XP bonus (supporter +25%, monthly +50%). Daily = threads * SCRAPE_DAILY_GAMES_PER_THREAD.
SCRAPE_GUEST_THREADS=1
SCRAPE_ADMIN_THREADS=20
SCRAPE_SUPPORTER_BONUS_THREADS=2
SCRAPE_MONTHLY_SUPPORTER_BONUS_THREADS=4
XP_SUPPORTER_BONUS_PCT=25
XP_MONTHLY_SUPPORTER_BONUS_PCT=50
SCRAPE_DAILY_GAMES_PER_THREAD=1000
SCRAPE_RPM_PER_THREAD=100 
# Threads are also concurrent requests: an account with 4 threads has at most
# 4 requests in flight (429 + Retry-After beyond that). The rate limit allows
# bursts of about 5 s. Game lookups across every account share this in-flight
# cap (503 + Retry-After when full). 0 = default 16, -1 = no cap.
#SCRAPE_MAX_INFLIGHT=16

# Donations (Ko-fi / Patreon -> donor status). KOFI_VERIFICATION_TOKEN is the
# token from the Ko-fi webhooks page; leave empty to disable the webhook.
# PATREON_WEBHOOK_SECRET is the secret of the Patreon member webhook; leave
# empty to disable it. DONOR_SUBSCRIPTION_GRACE_DAYS is the inactivity window
# after which a monthly supporter with no fresh subscription payment is
# downgraded (default 40).
KOFI_VERIFICATION_TOKEN=
PATREON_WEBHOOK_SECRET=
DONOR_SUBSCRIPTION_GRACE_DAYS=40

# XP economy (XP awarded per approved contribution).
POINTS_TEXT_METADATA=10
POINTS_IMAGE_METADATA=50
POINTS_VIDEO_METADATA=100
POINTS_SAP_IMAGE=20
POINTS_NEW_GAME=100

# Scraping debug overrides (forcerequestok/forcethreads/forceratelimit) via
# X-Debug-Password. Keep off in production.
ENABLE_DEBUG_MODE=false

# Allowed browser origins for CORS (comma separated).
CORS_ORIGINS=http://localhost:5173,http://localhost:8091

# Client IP for the per-IP rate limits: X-Forwarded-For is followed from the
# right past private/loopback hops (Traefik, a tunnel) to the first outside
# address; the CDN's client-address header is used when that is one of the
# CDN's addresses, or when the request only passed through private hops — so
# the origin must be reachable only through the CDN. Set to "always" if the
# proxy directly in front of the service has a public address (its
# X-Forwarded-For entry is then used too).
#TRUST_PROXY_HEADERS=
# The CDN in front of the service, Cloudflare by default (its ranges are built
# in). For another CDN set BOTH: its published edge ranges (comma separated)
# and a header it sets on every request with the client's address, overwriting
# any value the client sent. With nothing in front of Traefik (DNS only) set
# CDN_IP_RANGES=none and leave the header unset — but not behind a tunnel or
# ingress, where all clients would then share one rate-limit bucket.
#CDN_IP_RANGES=
#CDN_CLIENT_IP_HEADER=

# Set to "true" to allow login without verifying email (local dev only)
SKIP_EMAIL_VERIFICATION=false

# Account emails (SMTP) + links back to the web frontend
SMTP_HOST=smtp.mail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=NeoAssets Team
FRONTEND_URL=http://localhost:8091
# Public logo used in email headers. Falls back to the code default when empty.
EMAIL_LOGO_URL=

# Translate worker (Cloudflare Worker, Workers AI m2m100). When set, approving a
# metadata submission that carries an English description auto-generates the
# translations into game_translations / system_translations.
TRANSLATE_WORKER_URL=
TRANSLATE_WORKER_TOKEN=
